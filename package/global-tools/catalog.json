{
  "version": "0.3.0",
  "description": "Ferramentas, MCPs, plugins e skills instalados no perfil do usuario (globais), reutilizaveis em qualquer projeto.",
  "npm_globals": [
    {
      "id": "openwolf",
      "package": "openwolf",
      "check_command": "openwolf",
      "required": false
    },
    {
      "id": "firecrawl-cli",
      "package": "firecrawl-cli",
      "check_command": "firecrawl",
      "required": false
    }
  ],
  "uv_tools": [
    {
      "id": "graphify",
      "package": "graphifyy",
      "check_command": "graphify",
      "post_install": ["install"],
      "notes": "CLI + MCP em ~/.local/bin; post_install sincroniza skill do usuario"
    }
  ],
  "mcp_servers": [
    {
      "id": "context7",
      "name": "Context7",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "clients": ["claude", "cursor"]
    },
    {
      "id": "playwright",
      "name": "Playwright",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "clients": ["claude", "cursor", "codex"]
    },
    {
      "id": "sequential-thinking",
      "name": "Sequential Thinking",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"],
      "clients": ["claude", "cursor"]
    }
  ],
  "claude_plugins": [
    "context7@claude-plugins-official",
    "playwright@claude-plugins-official",
    "superpowers@claude-plugins-official",
    "skill-creator@claude-plugins-official",
    "atlassian@claude-plugins-official",
    "frontend-design@claude-plugins-official",
    "caveman@caveman"
  ],
  "skill_packages": [
    {
      "id": "superpowers",
      "source": "obra/superpowers",
      "notes": "using-superpowers + workflow skills"
    },
    {
      "id": "find-skills",
      "source": "vercel-labs/skills",
      "notes": "descoberta de skills"
    },
    {
      "id": "firecrawl",
      "source": "firecrawl/cli",
      "notes": "hub Firecrawl + variantes CLI"
    },
    {
      "id": "terraform-skill",
      "source": "antonbabenko/terraform-skill",
      "notes": "Terraform/OpenTofu best practices (Anton Babenko, 2.2k stars, ativo). Instala via npx skills add; alternativa gerenciada: marketplace antonbabenko/agent-plugins"
    },
    {
      "id": "caveman",
      "source": "juliusbrussee/caveman",
      "notes": "modo caveman — ~75% menos tokens de prosa"
    },
    {
      "id": "marketingskills",
      "source": "coreyhaines31/marketingskills",
      "notes": "Times Marketing e Social/Content: seo-audit, programmatic-seo, ai-seo, cro, ad-creative, mktg-psychology, copywriting, estrategia-de-conteudo, conteudo-pilar, fluxos-de-email (41.8k stars, MIT, ativo 2026-07-23)"
    },
    {
      "id": "anthropic-skills",
      "source": "anthropics/skills",
      "notes": "Times Design/Operacoes/Legal: canvas-design, algorithmic-art, web-artifacts-builder, brand-guidelines, xlsx, docx, pptx, pdf, mcp-builder, skill-creator (164k stars, oficial Anthropic)"
    }
  ],
  "departments": {
    "_comment": "Mapa dos 7 times (42 skills) para o que o orquestrador instala. Cobertura verificada em 2026-07-27.",
    "desenvolvedores": {
      "cobertura": "completa",
      "fontes": ["superpowers", "context7@claude-plugins-official", "anthropic-skills (mcp-builder, skill-creator)", "webapp-testing (superpowers)", "claude-mem@thedotmack"]
    },
    "design": {
      "cobertura": "quase completa",
      "fontes": ["frontend-design@claude-plugins-official", "anthropic-skills (canvas-design, algorithmic-art, web-artifacts-builder, slack-gif-creator)"],
      "faltando": "ui-ux-pro-max — instalacao propria via `npx ui-ux-pro-max-cli` (npm 2.11.0), fora do padrao `skills add`; instalar a mao se desejado"
    },
    "marketing": { "cobertura": "completa", "fontes": ["marketingskills"] },
    "social_content": { "cobertura": "completa", "fontes": ["marketingskills"] },
    "financeiro": {
      "cobertura": "parcial",
      "fontes": ["plugin finance@claude-plugins-official (journal-entry, reconciliation, financial-statements, variance-analysis)", "anthropic-skills (xlsx para modelagem)"],
      "faltando": "dcf-modelo, lbo-modelo, analise-comparativa, precificacao, pitch-deck — sem fonte publica verificada"
    },
    "operacoes": {
      "cobertura": "parcial",
      "fontes": ["plugin engineering@claude-plugins-official (incident-response, documentation, deploy-checklist)", "anthropic-skills (xlsx)"],
      "faltando": "sop-builder, business-case, playbook-de-lancamento — sem fonte publica verificada"
    },
    "legal": {
      "cobertura": "boa",
      "fontes": ["plugin legal@claude-plugins-official (review-contract, triage-nda, compliance-check, legal-risk-assessment)", "anthropic-skills (docx)"],
      "faltando": "consultas-sql — coberto por MCP de banco quando configurado"
    }
  }
}
